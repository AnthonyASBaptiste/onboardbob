# Environment Variables — demo-api-platform
#
# Copy this file to .env and fill in the required values.
# Variables marked ⚠️ REQUIRED must be set before the app will start.

# Database
DATABASE_URL=postgresql://demo_user:changeme_local_only@localhost:5432/demo_db

# Authentication
# ⚠️ REQUIRED — generate with: openssl rand -base64 32
JWT_SECRET=

# Stripe (payments)
# ⚠️ REQUIRED — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# App config
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
